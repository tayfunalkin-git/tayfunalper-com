Options -Indexes
RewriteEngine On

# www olmayanlari www'ye yonlendir (istege bagli, kaldirilabilir)
# RewriteCond %{HTTP_HOST} !^www\. [NC]
# RewriteRule ^ https://www.%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# HTTPS zorla (istege bagli, kaldirilabilir)
# RewriteCond %{HTTPS} off
# RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# .html uzantisiyla gelen istekleri uzantisiz URL'ye yonlendir (SEO icin)
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+(.+)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# Uzantisiz URL'leri .html dosyasina eslestir
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]
