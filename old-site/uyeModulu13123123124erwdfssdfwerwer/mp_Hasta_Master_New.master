<script language="javascript">

function ac()
{
document.getElementById('ctl00_ContentPlaceHolder1_gizlenecek').style.display = 'block';

document.getElementById('ctl00_ContentPlaceHolder1_digerleriniAc').style.display = 'none';
document.getElementById('ctl00_ContentPlaceHolder1_digerleriniKapa').style.display = 'block';
}

function kapa()
{
document.getElementById('ctl00_ContentPlaceHolder1_gizlenecek').style.display = 'none';
document.getElementById('ctl00_ContentPlaceHolder1_digerleriniAc').style.display = 'block';
document.getElementById('ctl00_ContentPlaceHolder1_digerleriniKapa').style.display = 'none';
}

</script>

<script language="javascript">

   var cookieValue = "";
   var search = "HastaBilgi" + "=";
   if(document.cookie.length > 0){
      offset = document.cookie.indexOf(search);
      if (offset == -1){
         
         window.location="../uyegiris.aspx";
         
         
         }
      }
   </script>

<script language=javascript>

function readCookie(name)
 
{
 
  var cookieValue = "";
 
  var search = name + "=";
 
  if(document.cookie.length > 0)
 
  { 
 
    offset = document.cookie.indexOf(search);
 
    if (offset != -1)
 
    { 
 
      offset += search.length;
 
      end = document.cookie.indexOf(";", offset);
 
      if (end == -1) end = document.cookie.length;
 
      cookieValue = unescape(document.cookie.substring(offset, end))
 
    }
 
  }
 
  return cookieValue;
 
}


</script>


<script language="javascript">

		var saniye
		var dakika 
		var timerID = null
		var timerRunning = false
		var delay = 1000
		ns=(document.layers);
		ie=(document.all);
		function Ayarlar()
		{
			dakika = 19
			saniye = 59
			SureBitisi()
			SureyiBaslat()
			
		}
		function SureBitisi()
		{
			if(timerRunning)
				clearTimeout(timerID)
			timerRunning = false
		}
		function SureyiBaslat()
		{
   			if (dakika<0)
   			{
   				SureBitisi()
   				alert("20 dakika süreyle hiç bir işlem yapmadığınız için bağlantınız kesilmiştir.Devam etmek için sisteme yeniden giriş yapınız.")
   				window.location="../uyegiris.aspx";
   				
   			}
   			else
   			{
   			
				if (saniye<10)	document.all.sure.innerHTML =dakika+":0"+saniye
				else document.all.sure.innerHTML = dakika+":"+saniye
				saniye = saniye - 1
				if (saniye==0) 
				{
					dakika=dakika-1
					saniye=59
				}
				timerRunning = true
				timerID = self.setTimeout("SureyiBaslat()", delay)
			}
		}
		if (ns||ie)window.onload=Ayarlar;
		
</script>



