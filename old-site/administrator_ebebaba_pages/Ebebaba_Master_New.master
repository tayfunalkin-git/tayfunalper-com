<script language="javascript">

   var cookieValue = "";
   var search = "AdminK" + "=";
   if(document.cookie.length > 0){
      offset = document.cookie.indexOf(search);
      if (offset == -1){
         
         window.location="signout.aspx";
         
         
         }
      }
   </script>

<script language=javascript>

function readCookie(name)
 
{
 
  var cookieValue = "";
 
  var search = name + "=";
 
  if(document.cookie.length > 0)
 
  { 
 
    offset = document.cookie.indexOf(search);
 
    if (offset != -1)
 
    { 
 
      offset += search.length;
 
      end = document.cookie.indexOf(";", offset);
 
      if (end == -1) end = document.cookie.length;
 
      cookieValue = unescape(document.cookie.substring(offset, end))
 
    }
 
  }
 
  return cookieValue;
 
}


</script>

<script language="javascript">



		var saniye
		var dakika 
		var timerID = null
		var timerRunning = false
		var delay = 1000
		ns=(document.layers);
		ie=(document.all);
		function Ayarlar()
		{
			dakika = readCookie("Adminsure")-1
			saniye = 59
			SureBitisi()
			SureyiBaslat()
			
		}
		function SureBitisi()
		{
			if(timerRunning)
				clearTimeout(timerID)
			timerRunning = false
		}
		function SureyiBaslat()
		{
   			if (dakika<0)
   			{
   				SureBitisi()
   				alert(readCookie("Adminsure") + " dakika süreyle hiç bir işlem yapmadığınız için bağlantınız kesilmiştir.Devam etmek için sisteme yeniden giriş yapınız.")
   				window.location="signout.aspx";
   				
   			}
   			else
   			{
   			
				if (saniye<10)	document.all.sure.innerHTML =dakika+":0"+saniye
				else document.all.sure.innerHTML = dakika+":"+saniye
				saniye = saniye - 1
				if (saniye==0) 
				{
					dakika=dakika-1
					saniye=59
				}
				timerRunning = true
				timerID = self.setTimeout("SureyiBaslat()", delay)
			}
		}
		if (ns||ie)window.onload=Ayarlar;
		
</script>


           <script>
               function popitup(url, pencere) {
                   var left = Math.round((screen.width / 2) - (550));
                   var top = Math.round((screen.height / 2) - (300));

                   newwindow = window.open(url, pencere, 'directories=no,titlebar=no,toolbar=no,location=yes,status=no,menubar=no,scrollbars=no,resizable=no,height=600,width=1100, top=' + top + ', left=' + left);
                   if (window.focus) { newwindow.focus() }
                   return false;
               }
   </script>



